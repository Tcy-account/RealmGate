# Local development defaults ONLY. Copy to .env (gitignored) and customize.
# Never put production secrets in this file or commit a real .env.

# ---- Docker Compose (postgres / redis / tools) ----
COMPOSE_PROJECT_NAME=realmgate

POSTGRES_DB=realmgate
POSTGRES_USER=realmgate
POSTGRES_PASSWORD=realmgate
POSTGRES_PORT=5432
REDIS_PORT=6379

# Optional admin UIs (docker compose --profile tools)
PGADMIN_EMAIL=admin@realmgate.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
REDIS_COMMANDER_PORT=8081

# ---- Monitoring stack (docker-compose.monitoring.yml) ----
GF_SECURITY_ADMIN_PASSWORD=changeme

# ---- realmgate-server (application-dev.yml) ----
# Spring Boot binds these; defaults in YAML keep local one-click working.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/realmgate
# SPRING_DATASOURCE_USERNAME=realmgate
# SPRING_DATASOURCE_PASSWORD=realmgate
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=

# Base64 HS256 key (decode length >= 32). Replace before any shared/public deploy.
REALMGATE_JWT_SECRET=ZGV2LW9ubHktcGxhY2Vob2xkZXItand0LXNlY3JldC0zMmJ5dGVzIQ==
# REALMGATE_JWT_EXPIRATION_MINUTES=60

# Optional profile override (default in application.yml is already "dev")
# SPRING_PROFILES_ACTIVE=dev